---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { photoIds } from "../lib/category-cards";

interface Props {
  id: (typeof photoIds)[number];
  images: ImageMetadata[];
}

const { id, images } = Astro.props;
const [first, second = first] = images;
// Each picture is drawn once at this width. The tiles are never wider than a card.
const size = { width: 560, quality: 70, alt: "", loading: "lazy", decoding: "async" } as const;
const burst = [
  { to: "translateX(-46%) rotate(-14deg)", delay: "0.09s" },
  { to: "translateX(-16%) rotate(-5deg)", delay: "0.06s" },
  { to: "translateX(16%) rotate(5deg)", delay: "0.03s" },
  { to: "translateX(46%) rotate(14deg)", delay: "0s" },
];
---

<div class={`vis vis-${id.slice(7)}`}>
  {
    id === "photos-exact" && (
      <>
        <div class="tile t-exact m" style="--from: translateX(-55%); --to: translate(-9%, -5%); --op-to: 0.5">
          <Image src={first} {...size} />
          <span class="mark"></span>
        </div>
        <div class="tile t-exact m" style="--from: translateX(55%); --to: translate(4%, 4%)">
          <Image src={first} {...size} />
        </div>
      </>
    )
  }

  {
    id === "photos-similar" && (
      <>
        <div class="tile t-similar left m" style="--to: translateX(12%) scale(0.88); --op-to: 0.55">
          <Image src={first} {...size} />
          <span class="mark"></span>
        </div>
        <div class="tile t-similar mid m" style="--to: scale(1.06)">
          <Image src={first} {...size} />
        </div>
        <div class="tile t-similar right m" style="--to: translateX(-12%) scale(0.88); --op-to: 0.55">
          <Image src={first} {...size} />
          <span class="mark"></span>
        </div>
      </>
    )
  }

  {
    id === "photos-bursts" &&
      burst.map((frame, i) => (
        <div class="tile t-burst m" style={`--to: ${frame.to}; --delay: ${frame.delay}`}>
          <Image src={first} {...size} />
          {i < 3 && <span class="mark"></span>}
        </div>
      ))
  }

  {
    id === "photos-blurry" && (
      <>
        <div class="fill">
          <Image src={first} {...size} />
        </div>
        <div class="fill soft m" style="--op-from: 0; --op-to: 1">
          <Image src={first} {...size} />
        </div>
      </>
    )
  }

  {
    id === "photos-exposure" && (
      <>
        <div class="fill half-left">
          <Image src={first} {...size} />
          <span class="veil dark m" style="--op-from: 0; --op-to: 0.7"></span>
        </div>
        <div class="fill half-right">
          <Image src={second} {...size} />
          <span class="veil light m" style="--op-from: 0; --op-to: 0.6"></span>
        </div>
      </>
    )
  }

  {
    id === "photos-screenshots" && (
      <div class="phone m" style="--from: translateY(7%); --to: translateY(-3%)">
        <span class="status"></span>
        <Image class="shot" src={first} {...size} />
        <span class="navbar"></span>
      </div>
    )
  }

  {
    id === "photos-documents" && (
      <div class="doc">
        <Image class="shot" src={first} {...size} />
        <span class="scan m" style="--from: translateY(-100%); --to: translateY(0)"></span>
        <span class="corner tl"></span>
        <span class="corner tr"></span>
        <span class="corner bl"></span>
        <span class="corner br"></span>
      </div>
    )
  }

  {
    id === "photos-forwarded" && (
      <>
        <div class="bubble m" style="--from: translateX(-6%); --to: none">
          <Image src={first} {...size} />
        </div>
        <span class="fwd m" style="--from: translateX(-120%) scale(0.6); --op-from: 0; --to: none">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 5l6 6-6 6" /><path d="M20 11H9a5 5 0 0 0-5 5v2" /></svg>
        </span>
      </>
    )
  }

  {
    id === "photos-stickers" && (
      <div class="sticker m" style="--from: scale(0.86) rotate(-15deg); --to: rotate(-6deg)">
        <Image src={first} {...size} />
      </div>
    )
  }
</div>

<style>
  .vis {
    --shade: color-mix(in srgb, var(--bg) 60%, transparent);
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--bg);
    isolation: isolate;
  }

  .vis img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tile {
    position: absolute;
    overflow: hidden;
    border-radius: var(--radius-s);
    box-shadow:
      0 0 0 1px var(--shade),
      0 0.5rem 1rem var(--shade);
  }

  /* The red dot marks a photo the app would move to the trash. */
  .mark {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 2px var(--bg);
  }

  .fill {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  /* Exact copies */
  .t-exact {
    left: 30%;
    top: 10%;
    width: 40%;
    height: 80%;
  }

  /* Similar copies: the middle one is the best, the sides are a recompressed and a cropped one */
  .t-similar {
    top: 14%;
    width: 30%;
    height: 72%;
  }

  .t-similar.left {
    left: 3%;
  }

  .t-similar.mid {
    left: 35%;
    z-index: 1;
  }

  .t-similar.right {
    left: 67%;
  }

  .t-similar.left img {
    filter: saturate(0.55) contrast(0.85);
  }

  .t-similar.right img {
    transform: scale(1.45);
    transform-origin: 30% 40%;
  }

  /* Bursts */
  .t-burst {
    left: 32%;
    top: 14%;
    width: 36%;
    height: 72%;
    transform-origin: 50% 110%;
  }

  /* Blurry: a blurred copy of the picture fades in over the sharp one */
  .soft img {
    filter: blur(0.55rem);
    transform: scale(1.12);
  }

  /* Too dark or too bright: each half fades toward black or white */
  .half-left {
    right: 50%;
  }

  .half-right {
    left: 50%;
  }

  .veil {
    position: absolute;
    inset: 0;
  }

  .veil.dark {
    background: var(--bg);
  }

  .veil.light {
    background: var(--text);
  }

  /* Screenshots: the picture in a phone frame, with its status bar and navigation bar */
  .phone {
    position: absolute;
    left: 33%;
    top: 7%;
    width: 34%;
    height: 86%;
    padding: 0.2rem;
    overflow: hidden;
    border: 2px solid var(--line-strong);
    border-radius: var(--radius-m);
    background: var(--bg);
    box-shadow: 0 0.5rem 1rem var(--shade);
  }

  .phone .shot {
    border-radius: calc(var(--radius-m) - 0.35rem);
  }

  .status,
  .navbar {
    position: absolute;
    z-index: 1;
    left: 50%;
    height: 0.2rem;
    border-radius: var(--radius-pill);
    background: var(--text);
    opacity: 0.8;
    transform: translateX(-50%);
  }

  .status {
    top: 0.65rem;
    width: 30%;
  }

  .navbar {
    bottom: 0.55rem;
    width: 40%;
  }

  /* Documents: the picture inside the corners of a scan, with a line that has gone down it */
  .doc {
    position: absolute;
    inset: 9% 13%;
    overflow: hidden;
    border-radius: var(--radius-s);
  }

  .scan {
    position: absolute;
    inset: 0;
    border-bottom: 2px solid var(--accent);
    background: linear-gradient(to bottom, transparent, color-mix(in srgb, var(--accent) 30%, transparent));
  }

  .corner {
    position: absolute;
    width: 1.1rem;
    height: 1.1rem;
    border: 0 solid var(--text);
  }

  .corner.tl {
    top: 0.4rem;
    left: 0.4rem;
    border-width: 2px 0 0 2px;
  }

  .corner.tr {
    top: 0.4rem;
    right: 0.4rem;
    border-width: 2px 2px 0 0;
  }

  .corner.bl {
    bottom: 0.4rem;
    left: 0.4rem;
    border-width: 0 0 2px 2px;
  }

  .corner.br {
    right: 0.4rem;
    bottom: 0.4rem;
    border-width: 0 2px 2px 0;
  }

  /* Forwarded: a picture in a chat bubble, and the forward arrow beside it */
  .bubble {
    position: absolute;
    left: 14%;
    top: 12%;
    height: 76%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius-m) var(--radius-m) var(--radius-m) var(--radius-s);
    box-shadow: 0 0.5rem 1rem var(--shade);
  }

  .fwd {
    position: absolute;
    left: 74%;
    top: 40%;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--surface);
    color: var(--text);
    box-shadow: 0 0 0 1px var(--line-strong);
  }

  /* Stickers: a cut-out with a white edge */
  .sticker {
    position: absolute;
    left: 29%;
    top: 12%;
    width: 42%;
    height: 76%;
    overflow: hidden;
    border: 0.3rem solid var(--text);
    border-radius: 46% 54% 50% 50% / 42% 44% 56% 58%;
    box-shadow: 0 0.5rem 1rem var(--shade);
  }
</style>
