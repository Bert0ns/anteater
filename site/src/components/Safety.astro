---
import { strings, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = strings[lang].safety;
---

<!-- The id stays "trash", so the "Trash" links of the header and the footer keep working. -->
<section id="trash" class="safety" aria-labelledby="safety-title">
  <h2 id="safety-title">{t.title}</h2>
  <p class="safety-lead">{t.lead}</p>

  <ol class="flow" role="list">
    {
      t.steps.map((step, i) => (
        <li class="flow-step">
          <span class="flow-num" aria-hidden="true">{i + 1}</span>
          <div class="flow-body">
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </div>
        </li>
      ))
    }
  </ol>

  <div class="also">
    {
      t.also.map((item) => (
        <div class="also-card">
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  .safety-lead {
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .flow {
    --num: 2.5rem;
    position: relative;
    display: grid;
    gap: var(--space-6);
    margin: var(--space-6) 0;
    list-style: none;
  }

  /* The rail behind the numbers. The red one fills as the list scrolls into view, and is full without it. */
  .flow::before,
  .flow::after {
    content: "";
    position: absolute;
    top: calc(var(--num) / 2);
    bottom: calc(var(--num) / 2);
    left: calc(var(--num) / 2 - 1px);
    z-index: 0;
    width: 2px;
  }

  .flow::before {
    background: var(--line);
  }

  .flow::after {
    background: var(--accent);
    transform-origin: top;
  }

  .flow-step {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: var(--num) minmax(0, 1fr);
    gap: var(--space-4);
  }

  .flow-num {
    display: grid;
    place-items: center;
    width: var(--num);
    height: var(--num);
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: var(--bg);
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 700;
    line-height: 1;
    color: var(--accent-text);
  }

  .flow-body {
    padding-top: var(--space-1);
  }

  .flow-body h3 {
    margin-bottom: var(--space-1);
    font-size: var(--step-2);
  }

  .also {
    display: grid;
    gap: var(--space-4);
  }

  .also-card {
    padding: var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    background: var(--surface);
  }

  .also-card h3 {
    margin-bottom: var(--space-2);
  }

  .also-card p {
    font-size: var(--step--1);
  }

  @media (min-width: 40rem) {
    .also {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .flow::after {
        animation: rail-fill linear both;
        animation-timeline: view();
        animation-range: entry 20% contain 60%;
      }

      .flow-step {
        animation: step-in var(--dur-slow) var(--ease-out) both;
        animation-timeline: view();
        animation-range: entry 0% entry 50%;
      }
    }
  }

  @keyframes rail-fill {
    from {
      transform: scaleY(0);
    }
  }

  @keyframes step-in {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
  }
</style>
