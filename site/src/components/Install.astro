---
import { strings, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = strings[lang].install;
const repo = "https://github.com/Bert0ns/anteater";
// The release has anteater-<version>.apk and anteater-<version>.apk.sha256 side by side.
const checkCommand = "sha256sum -c *.apk.sha256";
---

<section id="install" class="install">
  <h2>{t.title}</h2>

  <div class="install-main">
    <p class="install-lead">{t.lead}</p>
    <div class="install-cta">
      <a href={`${repo}/releases/latest`} class="btn btn-primary"><span class="dot" aria-hidden="true"></span>{t.download}</a>
    </div>
    <p class="meta-text">{t.requirements}</p>

    <ol class="install-steps" role="list" aria-label={t.stepsLabel}>
      {
        t.steps.map((step) => (
          <li class="install-step">
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))
      }
    </ol>

    <div class="install-verify">
      <h3>{t.verify.title}</h3>
      <p>{t.verify.body}</p>
      <div class="install-code">
        <code id="install-command">{checkCommand}</code>
        <button
          type="button"
          class="install-copy"
          hidden
          data-text={checkCommand}
          data-copy={t.verify.copy}
          data-copied={t.verify.copied}>{t.verify.copy}</button
        >
        <span class="install-status" role="status"></span>
      </div>
    </div>

    <p class="install-play">{t.play.text}</p>
  </div>
</section>

<script>
  // The command is plain text and can be selected without this. With JavaScript, a copy button
  // shows up next to it.
  const button = document.querySelector<HTMLButtonElement>(".install-copy");
  const status = document.querySelector<HTMLElement>(".install-status");
  if (button && navigator.clipboard) {
    button.hidden = false;
    let timer: number | undefined;
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.text ?? "");
      } catch {
        // No permission to write. Select the command, so the user can copy it by hand.
        const code = document.getElementById("install-command");
        if (code) getSelection()?.selectAllChildren(code);
        return;
      }
      button.textContent = button.dataset.copied ?? "";
      if (status) status.textContent = button.dataset.copied ?? "";
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        button.textContent = button.dataset.copy ?? "";
        if (status) status.textContent = "";
      }, 2000);
    });
  }
</script>

<style>
  .install-main {
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }

  .install-lead {
    max-width: 38rem;
    margin: 0;
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .install-cta {
    margin: 0;
  }

  .install-main > .meta-text {
    margin: calc(var(--space-3) * -1) 0 0;
  }

  .install-steps {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-3);
    list-style: none;
    counter-reset: install-step;
  }

  .install-step {
    position: relative;
    padding: var(--space-5) var(--space-5) var(--space-5) var(--space-7);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    background: var(--surface);
    counter-increment: install-step;
  }

  .install-step::before {
    content: counter(install-step);
    content: counter(install-step) / "";
    position: absolute;
    left: var(--space-5);
    top: var(--space-5);
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 700;
    line-height: 1.1;
    color: var(--accent-text);
  }

  .install-step h3 {
    margin-bottom: var(--space-1);
  }

  .install-step p {
    font-size: var(--step--1);
  }

  .install-verify {
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
  }

  .install-verify h3 {
    margin-bottom: var(--space-1);
  }

  .install-verify p {
    max-width: 38rem;
    font-size: var(--step--1);
  }

  .install-code {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-3);
    padding: var(--space-2) var(--space-2) var(--space-2) var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    background: var(--surface);
  }

  .install-code code {
    min-width: 0;
    overflow-wrap: anywhere;
    user-select: all;
  }

  .install-copy {
    flex: none;
    min-height: 2.25rem;
    padding: 0 var(--space-4);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--text-muted);
    font-family: var(--font-text);
    font-size: var(--step--1);
    font-weight: 600;
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .install-status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .install-copy:hover {
    color: var(--text);
    border-color: var(--text-dim);
  }

  .install-play {
    margin: 0;
    font-size: var(--step--1);
    color: var(--text-dim);
  }

  @media (min-width: 40rem) {
    .install-steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* The end state is the plain page. Where scroll-driven animations exist and motion is welcome,
     each step rises a little as it enters the view. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .install-step {
        animation: install-rise var(--dur-slow) var(--ease-out) both;
        animation-timeline: view();
        animation-range: entry 0% entry 40%;
      }
    }
  }

  @keyframes install-rise {
    from {
      opacity: 0;
      transform: translateY(1.5rem);
    }
  }
</style>
