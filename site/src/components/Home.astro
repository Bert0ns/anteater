---
import Base from "../layouts/Base.astro";
import CategoryCards from "./CategoryCards.astro";
import CompressionSlider from "./CompressionSlider.astro";
import FeatureList from "./FeatureList.astro";
import Hero from "./Hero.astro";
import Install from "./Install.astro";
import Privacy from "./Privacy.astro";
import Safety from "./Safety.astro";
import StorageMap from "./StorageMap.astro";
import { pagePath, strings, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = strings[lang];
const repo = "https://github.com/Bert0ns/anteater";
const features = pagePath(lang, "features");
---

<Base lang={lang}>
  <main id="main">
  <Hero lang={lang} />

  <div class="sections container">
    <Privacy lang={lang} />
    <Safety lang={lang} />

    <CategoryCards lang={lang} group="photos" />
    <CategoryCards lang={lang} group="videos" />

    <section id="compress">
      <h2>{t.compress.title}</h2>
      <p>{t.compress.intro}</p>
      <CompressionSlider lang={lang} />
      <FeatureList items={t.compress.items} />
      <p><a class="text-link" href={`${features}#compress`}>{t.compress.more}</a></p>
    </section>

    <StorageMap lang={lang} />

    <Install lang={lang} />

    <section id="source">
      <h2>{t.source.title}</h2>
      <p>
        {t.source.before}<a class="text-link" href={`${repo}/blob/main/LICENSE`}>{t.source.license}</a>{t.source.after}<a class="text-link" href={repo} target="_blank" rel="noopener noreferrer">{repo}</a>
      </p>
    </section>
  </div>
  </main>

</Base>
