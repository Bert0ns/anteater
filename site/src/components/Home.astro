---
import Base from "../layouts/Base.astro";
import FeatureList from "./FeatureList.astro";
import Install from "./Install.astro";
import Privacy from "./Privacy.astro";
import Safety from "./Safety.astro";
import Screenshots from "./Screenshots.astro";
import StorageMap from "./StorageMap.astro";
import { pagePath, strings, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = strings[lang];
const repo = "https://github.com/Bert0ns/anteater";
// The home page keeps a short version of these. Each links to its part of the features page.
const sections = ["photos", "videos", "compress"] as const;
const anchors = { photos: "clean", videos: "videos", compress: "compress" } as const;
const features = pagePath(lang, "features");
---

<Base lang={lang}>
  <main id="main">
  <div class="hero container">
    <h1>{t.hero.title}</h1>
    <p class="hero-lead">{t.hero.lead}</p>

    <div class="cta-row">
      <a href={`${repo}/releases/latest`} class="btn btn-primary"><span class="dot" aria-hidden="true"></span>{t.hero.download}</a>
      <a href={repo} class="btn btn-secondary" target="_blank" rel="noopener noreferrer">{t.hero.viewSource}</a>
    </div>
    <p class="meta-text">{t.hero.requirements}</p>
    <p class="meta-text">{t.hero.caveat}</p>

    <Screenshots lang={lang} />
  </div>

  <div class="sections container">
    <Privacy lang={lang} />
    <Safety lang={lang} />

    {
      sections.map((key) => (
        <section id={anchors[key]}>
          <h2>{t[key].title}</h2>
          <p>{t[key].intro}</p>
          <FeatureList items={t[key].items} />
          <p><a class="text-link" href={`${features}#${key}`}>{t[key].more}</a></p>
        </section>
      ))
    }

    <StorageMap lang={lang} />

    <Install lang={lang} />

    <section id="source">
      <h2>{t.source.title}</h2>
      <p>
        {t.source.before}<a class="text-link" href={`${repo}/blob/main/LICENSE`}>{t.source.license}</a>{t.source.after}<a class="text-link" href={repo} target="_blank" rel="noopener noreferrer">{repo}</a>
      </p>
    </section>
  </div>
  </main>

</Base>
