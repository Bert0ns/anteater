---
import { getImage, Image } from "astro:assets";
import { strings, type Lang } from "../i18n";

import enHome from "../../screenshots/en/home.png";
import enCategory from "../../screenshots/en/category.png";
import enGroup from "../../screenshots/en/group.png";
import enFullSize from "../../screenshots/en/full-size.png";
import enVideos from "../../screenshots/en/videos.png";
import enShortClips from "../../screenshots/en/short-clips.png";
import enVideoFullSize from "../../screenshots/en/video-full-size.png";
import enCompress from "../../screenshots/en/compress.png";
import enCompressSummary from "../../screenshots/en/compress-summary.png";
import enTrash from "../../screenshots/en/trash.png";
import enSettings from "../../screenshots/en/settings.png";
import enStorageMap from "../../screenshots/en/storage-map.png";

import itHome from "../../screenshots/it/home.png";
import itCategory from "../../screenshots/it/category.png";
import itGroup from "../../screenshots/it/group.png";
import itFullSize from "../../screenshots/it/full-size.png";
import itVideos from "../../screenshots/it/videos.png";
import itShortClips from "../../screenshots/it/short-clips.png";
import itVideoFullSize from "../../screenshots/it/video-full-size.png";
import itCompress from "../../screenshots/it/compress.png";
import itCompressSummary from "../../screenshots/it/compress-summary.png";
import itTrash from "../../screenshots/it/trash.png";
import itSettings from "../../screenshots/it/settings.png";
import itStorageMap from "../../screenshots/it/storage-map.png";

interface Props {
  lang: Lang;
}

// The order matches `screenshots.items` in the string files.
const enImages = [
  enHome,
  enCategory,
  enGroup,
  enFullSize,
  enVideos,
  enShortClips,
  enVideoFullSize,
  enCompress,
  enCompressSummary,
  enTrash,
  enSettings,
  enStorageMap,
];

const itImages = [
  itHome,
  itCategory,
  itGroup,
  itFullSize,
  itVideos,
  itShortClips,
  itVideoFullSize,
  itCompress,
  itCompressSummary,
  itTrash,
  itSettings,
  itStorageMap,
];

const { lang } = Astro.props;
const images = lang === "it" ? itImages : enImages;
const fullImages = await Promise.all(
  images.map((src) => getImage({ src, width: 822, height: 1782, format: "webp" })),
);
const t = strings[lang].screenshots;
const repo = "https://github.com/Bert0ns/anteater";
const fill = (text: string, values: Record<string, string | number>) =>
  text.replace(/\{(\w+)\}/g, (_, name) => String(values[name] ?? ""));
---

<div class="screenshots-gallery" data-screenshots data-counter-template={t.counter}>
  <div class="screenshots" role="region" aria-label={t.label}>
    {
      t.items.map((item, i) => (
        <figure
          class="screenshot-figure"
          data-screenshot-item
          data-full-src={fullImages[i].src}
          data-full-alt={item.alt}
          data-caption={item.caption}
          data-open-label={fill(t.openLabel, { caption: item.caption })}
        >
          <div class="screenshot-frame">
            <Image
              src={images[i]}
              alt={item.alt}
              class="screenshot-img"
              widths={[280, 560]}
              sizes="(min-width: 40rem) 240px, 62vw"
              width={822}
              height={1782}
              format="webp"
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption class="screenshot-caption">{item.caption}</figcaption>
        </figure>
      ))
    }
  </div>

  <p class="screenshots-note">
    {t.note}{" "}
    <a class="text-link" href={`${repo}/blob/main/site/src/assets/samples/provenance.json`} target="_blank" rel="noopener noreferrer">
      {t.noteLink}
    </a>
  </p>

  <dialog class="screenshot-dialog" data-screenshot-dialog aria-label={t.dialogLabel}>
    <div class="screenshot-dialog-shell">
      <div class="screenshot-dialog-bar">
        <p class="screenshot-dialog-counter" data-dialog-counter aria-live="polite"></p>
        <button type="button" class="screenshot-dialog-btn screenshot-dialog-close" data-dialog-close aria-label={t.close}>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M6 6l12 12M18 6L6 18" />
          </svg>
        </button>
      </div>

      <div class="screenshot-dialog-stage">
        <button type="button" class="screenshot-dialog-btn screenshot-dialog-prev" data-dialog-prev aria-label={t.previous}>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M15 6l-6 6 6 6" />
          </svg>
        </button>

        <div class="screenshot-dialog-frame">
          <img class="screenshot-dialog-img" data-dialog-img width="822" height="1782" alt="" />
        </div>

        <button type="button" class="screenshot-dialog-btn screenshot-dialog-next" data-dialog-next aria-label={t.next}>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M9 6l6 6-6 6" />
          </svg>
        </button>
      </div>

      <p class="screenshot-dialog-caption" data-dialog-caption></p>
    </div>
  </dialog>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-screenshots]").forEach(setup);

  function setup(root: HTMLElement) {
    const dialog = root.querySelector<HTMLDialogElement>("[data-screenshot-dialog]");
    const dialogImg = root.querySelector<HTMLImageElement>("[data-dialog-img]");
    const dialogCaption = root.querySelector<HTMLElement>("[data-dialog-caption]");
    const dialogCounter = root.querySelector<HTMLElement>("[data-dialog-counter]");
    const closeBtn = root.querySelector<HTMLButtonElement>("[data-dialog-close]");
    const prevBtn = root.querySelector<HTMLButtonElement>("[data-dialog-prev]");
    const nextBtn = root.querySelector<HTMLButtonElement>("[data-dialog-next]");
    const figures = [...root.querySelectorAll<HTMLElement>("[data-screenshot-item]")];
    const counterTemplate = root.dataset.counterTemplate ?? "{current} / {total}";

    if (!dialog || !dialogImg || !dialogCaption || !dialogCounter || figures.length === 0) return;

    const items = figures.map((figure, index) => {
      const frame = figure.querySelector<HTMLElement>(".screenshot-frame");
      const trigger = document.createElement("button");
      trigger.type = "button";
      trigger.className = "screenshot-trigger";
      trigger.ariaLabel = figure.dataset.openLabel ?? "";
      if (frame) {
        figure.insertBefore(trigger, frame);
        trigger.appendChild(frame);
      }
      trigger.addEventListener("click", () => open(index, trigger));
      return {
        src: figure.dataset.fullSrc ?? "",
        alt: figure.dataset.fullAlt ?? "",
        caption: figure.dataset.caption ?? "",
        trigger,
      };
    });

    let current = 0;
    let lastTrigger: HTMLButtonElement | null = null;

    function show(index: number) {
      current = (index + items.length) % items.length;
      const item = items[current];
      dialogImg!.src = item.src;
      dialogImg!.alt = item.alt;
      dialogCaption!.textContent = item.caption;
      dialogCounter!.textContent = counterTemplate
        .replace("{current}", String(current + 1))
        .replace("{total}", String(items.length));
    }

    function open(index: number, trigger: HTMLButtonElement) {
      lastTrigger = trigger;
      show(index);
      if (!dialog!.open) dialog!.showModal();
    }

    closeBtn?.addEventListener("click", () => dialog.close());
    prevBtn?.addEventListener("click", () => show(current - 1));
    nextBtn?.addEventListener("click", () => show(current + 1));

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        show(current - 1);
      } else if (event.key === "ArrowRight") {
        event.preventDefault();
        show(current + 1);
      }
    });

    dialog.addEventListener("close", () => {
      lastTrigger?.focus();
      lastTrigger = null;
    });
  }
</script>

<style>
  .screenshot-dialog {
    width: min(44rem, calc(100vw - 2 * var(--space-4)));
    max-width: none;
    max-height: calc(100dvh - 2 * var(--space-4));
    margin: auto;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-l);
    background: var(--surface);
    color: var(--text);
    box-shadow: 0 1.5rem 3.5rem color-mix(in srgb, var(--bg) 85%, transparent);
    overscroll-behavior: contain;
  }

  .screenshot-dialog::backdrop {
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: blur(4px);
  }

  .screenshot-dialog-shell {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    gap: var(--space-3);
    max-height: calc(100dvh - 2 * var(--space-4) - 2px);
    padding: var(--space-4);
  }

  .screenshot-dialog-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .screenshot-dialog-counter {
    margin: 0;
    font-size: var(--step--1);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--text-muted);
  }

  .screenshot-dialog-btn {
    display: grid;
    place-items: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    background: var(--raised);
    color: var(--text);
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .screenshot-dialog-btn:hover {
    background: var(--line);
    border-color: var(--text-dim);
  }

  .screenshot-dialog-stage {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: var(--space-3);
    align-items: center;
    justify-items: center;
    min-height: 0;
  }

  .screenshot-dialog-frame {
    grid-column: 1 / -1;
    grid-row: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 0;
    max-height: 100%;
  }

  .screenshot-dialog-prev {
    grid-column: 1;
    grid-row: 2;
    justify-self: start;
  }

  .screenshot-dialog-next {
    grid-column: 2;
    grid-row: 2;
    justify-self: end;
  }

  .screenshot-dialog-img {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: calc(100dvh - 14rem);
    aspect-ratio: 822 / 1782;
    object-fit: contain;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-l);
    background: var(--bg);
  }

  .screenshot-dialog-caption {
    margin: 0;
    text-align: center;
    font-size: var(--step-0);
    font-weight: 500;
    color: var(--text);
  }

  @media (min-width: 40rem) {
    .screenshot-dialog-stage {
      grid-template-columns: auto minmax(0, 1fr) auto;
      grid-template-rows: minmax(0, 1fr);
      gap: var(--space-4);
    }

    .screenshot-dialog-prev {
      grid-column: 1;
      grid-row: 1;
      justify-self: center;
    }

    .screenshot-dialog-frame {
      grid-column: 2;
      grid-row: 1;
    }

    .screenshot-dialog-next {
      grid-column: 3;
      grid-row: 1;
      justify-self: center;
    }

    .screenshot-dialog-img {
      max-height: calc(100dvh - 11rem);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .screenshot-dialog[open] {
      animation: screenshot-dialog-in var(--dur-fast) var(--ease-out);
    }
  }

  @keyframes screenshot-dialog-in {
    from {
      opacity: 0;
      transform: scale(0.98);
    }
  }

  @media (scripting: none) {
    .screenshot-dialog {
      display: none;
    }
  }
</style>
