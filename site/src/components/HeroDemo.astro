---
import { Image } from "astro:assets";
import { loadScreenshot, SCREEN_HEIGHT, SCREEN_WIDTH, screenIds } from "../lib/hero-demo";
import { strings, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = strings[lang].hero.demo;
const repo = "https://github.com/Bert0ns/anteater";

const screens = screenIds.map((id, i) => ({
  id,
  index: i,
  image: loadScreenshot(lang, id),
  copy: t.screens[id],
  initial: i === 0,
}));
---

<figure class="demo" data-hero-demo aria-label={t.label}>
  <div class="phone-wrap">
    <div class="phone">
      <div class="screen" style={`aspect-ratio: ${SCREEN_WIDTH} / ${SCREEN_HEIGHT};`}>
        {
          screens.map((s) => (
            <div
              class:list={["panel", s.initial && "is-active"]}
              id={`hero-panel-${s.id}`}
              role="tabpanel"
              aria-labelledby={`hero-tab-${s.id}`}
              data-panel={s.id}
            >
              <Image
                src={s.image}
                alt={s.copy.alt}
                width={SCREEN_WIDTH}
                height={SCREEN_HEIGHT}
                widths={[320, 640]}
                sizes="(min-width: 56.25rem) 288px, 260px"
                format="webp"
                loading={s.initial ? "eager" : "lazy"}
                fetchpriority={s.initial ? "high" : undefined}
                decoding="async"
                class="shot"
              />
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <div class="side">
    <div class="tabs" role="tablist" aria-label={t.tabsLabel}>
      {
        screens.map((s) => (
          <button
            type="button"
            class="tab"
            id={`hero-tab-${s.id}`}
            role="tab"
            aria-selected={s.initial ? "true" : "false"}
            aria-controls={`hero-panel-${s.id}`}
            tabindex={s.initial ? "0" : "-1"}
            data-tab={s.id}
          >
            <span class="tab-dot" aria-hidden="true" />
            <span class="tab-label">{s.copy.tab}</span>
          </button>
        ))
      }
    </div>

    <div class="captions">
      {
        screens.map((s) => (
          <p class:list={["caption", s.initial && "is-active"]} data-caption={s.id}>
            {s.copy.caption}
          </p>
        ))
      }
    </div>

    <p class="note">
      {t.note}{" "}
      <a
        class="text-link"
        href={`${repo}/blob/main/site/src/assets/samples/provenance.json`}
        target="_blank"
        rel="noopener noreferrer">{t.noteLink}</a
      >
    </p>
  </div>
</figure>

<style>
  .demo {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-5) var(--space-7);
  }

  .phone-wrap {
    flex: none;
    width: clamp(15.5rem, 23vw, 18.5rem);
  }

  .phone {
    padding: var(--space-2);
    border: 2px solid var(--line-strong);
    border-radius: calc(var(--radius-l) + var(--space-2));
    background: var(--bg);
    box-shadow: 0 var(--space-5) var(--space-7) color-mix(in srgb, var(--bg) 75%, transparent);
  }

  .screen {
    position: relative;
    display: grid;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--surface);
  }

  .panel {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity var(--dur-base) var(--ease-out),
      visibility 0s linear var(--dur-base);
  }

  .panel.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition:
      opacity var(--dur-base) var(--ease-out),
      visibility 0s linear 0s;
  }

  .shot {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .side {
    flex: 1 1 16rem;
    max-width: 19rem;
    min-width: 0;
    display: grid;
    gap: var(--space-4);
  }

  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tab {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.25rem;
    padding: 0 var(--space-3);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--text-muted);
    font-family: var(--font-text);
    font-size: var(--step--1);
    font-weight: 600;
    line-height: 1.2;
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .tab:hover {
    background: var(--surface);
    border-color: var(--text-dim);
    color: var(--text);
  }

  .tab[aria-selected="true"] {
    background: var(--text);
    border-color: var(--text);
    color: var(--bg);
  }

  .tab-dot {
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--line-strong);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }

  .tab:hover .tab-dot {
    background: var(--text-dim);
  }

  .tab[aria-selected="true"] .tab-dot {
    background: var(--accent);
  }

  /* Every caption occupies the same grid cell so switching tabs never changes the height. */
  .captions {
    display: grid;
  }

  .caption {
    grid-area: 1 / 1;
    margin: 0;
    font-size: var(--step-0);
    color: var(--text);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--dur-fast) var(--ease-out),
      visibility 0s linear var(--dur-fast);
  }

  .caption.is-active {
    opacity: 1;
    visibility: visible;
    transition:
      opacity var(--dur-fast) var(--ease-out),
      visibility 0s linear 0s;
  }

  .note {
    margin: 0;
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
    font-size: var(--step--1);
    color: var(--text-dim);
  }

  @media (scripting: none) {
    .tabs {
      display: none;
    }

    .panel:not(.is-active),
    .caption:not(.is-active) {
      display: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-hero-demo]").forEach(setup);

  function setup(demo: HTMLElement) {
    const tabs = [...demo.querySelectorAll<HTMLButtonElement>("[data-tab]")];
    const panels = new Map(
      [...demo.querySelectorAll<HTMLElement>("[data-panel]")].map((el) => [el.dataset.panel!, el]),
    );
    const captions = new Map(
      [...demo.querySelectorAll<HTMLElement>("[data-caption]")].map((el) => [el.dataset.caption!, el]),
    );
    if (tabs.length === 0) return;

    let activeIndex = 0;
    let timer = 0;
    let warmTimer = 0;
    let stopped = false;
    let paused = false;
    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");

    const style = getComputedStyle(demo);
    const ms = (token: string) => {
      const value = style.getPropertyValue(token).trim();
      return parseFloat(value) * (value.endsWith("ms") ? 1 : 1000);
    };
    const stepDelay = Math.max(ms("--dur-hero") * 3.2, 3200);

    function warmImage(index: number) {
      const targetId = tabs[(index + tabs.length) % tabs.length]?.dataset.tab;
      const img = targetId ? panels.get(targetId)?.querySelector<HTMLImageElement>("img[loading='lazy']") : null;
      if (img) img.loading = "eager";
    }

    function warmImages() {
      demo.querySelectorAll<HTMLImageElement>("img[loading='lazy']").forEach((img) => {
        img.loading = "eager";
      });
    }

    function activate(index: number, focusTab = false) {
      activeIndex = (index + tabs.length) % tabs.length;
      const targetId = tabs[activeIndex].dataset.tab!;

      tabs.forEach((tab, i) => {
        const selected = i === activeIndex;
        tab.setAttribute("aria-selected", String(selected));
        tab.tabIndex = selected ? 0 : -1;
        if (selected && focusTab) tab.focus();
      });

      panels.forEach((panel, id) => {
        panel.classList.toggle("is-active", id === targetId);
      });

      captions.forEach((caption, id) => {
        caption.classList.toggle("is-active", id === targetId);
      });
    }

    function clearTimer() {
      if (timer) {
        window.clearTimeout(timer);
        timer = 0;
      }
      if (warmTimer) {
        window.clearTimeout(warmTimer);
        warmTimer = 0;
      }
    }

    function stopAuto() {
      stopped = true;
      clearTimer();
    }

    function scheduleNext(remaining: number) {
      clearTimer();
      if (stopped || paused || remaining <= 0 || reducedMotion.matches) return;
      warmTimer = window.setTimeout(() => {
        warmTimer = 0;
        if (!stopped && !paused && !reducedMotion.matches) warmImage(activeIndex + 1);
      }, stepDelay / 2);
      timer = window.setTimeout(() => {
        if (stopped || paused || reducedMotion.matches) return;
        activate(activeIndex + 1);
        scheduleNext(remaining - 1);
      }, stepDelay);
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => {
        warmImages();
        stopAuto();
        activate(i);
      });

      tab.addEventListener("keydown", (event) => {
        let next = -1;
        if (event.key === "ArrowRight" || event.key === "ArrowDown") {
          next = (i + 1) % tabs.length;
        } else if (event.key === "ArrowLeft" || event.key === "ArrowUp") {
          next = (i - 1 + tabs.length) % tabs.length;
        } else if (event.key === "Home") {
          next = 0;
        } else if (event.key === "End") {
          next = tabs.length - 1;
        }
        if (next >= 0) {
          event.preventDefault();
          warmImages();
          stopAuto();
          activate(next, true);
        }
      });
    });

    demo.addEventListener("pointerenter", () => {
      paused = true;
      clearTimer();
      warmImages();
    });
    demo.addEventListener("pointerleave", () => {
      paused = false;
    });
    demo.addEventListener("focusin", () => {
      paused = true;
      clearTimer();
      warmImages();
    });
    demo.addEventListener("focusout", (event) => {
      if (!demo.contains(event.relatedTarget as Node | null)) {
        paused = false;
      }
    });

    // Run a single auto-advance pass through the screens when the phone scrolls into view,
    // unless reduced motion is set or the user takes over.
    if (!reducedMotion.matches) {
      const startCycle = () => {
        scheduleNext(tabs.length - 1);
      };
      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            if (!entries.some((entry) => entry.isIntersecting)) return;
            observer.disconnect();
            startCycle();
          },
          { threshold: 0.6 },
        );
        observer.observe(demo);
      } else {
        startCycle();
      }
    }
  }
</script>
